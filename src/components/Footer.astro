</footer>

<script>
  // Dynamic Year Function (JavaScript en tiempo real del navegador)
  const setDynamicYear = () => {
    const yearSpan = document.getElementById('current-year');
    if (yearSpan) {
      yearSpan.textContent = new Date().getFullYear().toString();
    }
  };

  // Run on load and DOM ready
  setDynamicYear();
  document.addEventListener('DOMContentLoaded', setDynamicYear);

  const scrollBtn = document.getElementById('scroll-to-top');
  if (scrollBtn) {
    scrollBtn.addEventListener('click', () => {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  }

  // Legal Modal Handler (Política y Privacidad & Cookies)
  const modal = document.getElementById('legal-modal');
  const btnPrivacy = document.getElementById('open-privacy-modal');
  const btnCookies = document.getElementById('open-cookies-modal');
  const btnClose = document.getElementById('close-legal-modal');
  const btnConfirm = document.getElementById('confirm-legal-modal');
  const contentPrivacy = document.getElementById('modal-content-privacy');
  const contentCookies = document.getElementById('modal-content-cookies');

  const openModal = (type: 'privacy' | 'cookies') => {
    if (!modal || !contentPrivacy || !contentCookies) return;
    if (type === 'privacy') {
      contentPrivacy.classList.remove('hidden');
      contentCookies.classList.add('hidden');
    } else {
      contentPrivacy.classList.add('hidden');
      contentCookies.classList.remove('hidden');
    }
    modal.classList.remove('hidden');
    document.body.style.overflow = 'hidden';
  };

  const closeModal = () => {
    if (!modal) return;
    modal.classList.add('hidden');
    document.body.style.overflow = '';
  };

  btnPrivacy?.addEventListener('click', () => openModal('privacy'));
  btnCookies?.addEventListener('click', () => openModal('cookies'));
  btnClose?.addEventListener('click', closeModal);
  btnConfirm?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
</script>

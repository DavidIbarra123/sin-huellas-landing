---
export interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: string;
}

const {
  title = "Sin Huellas | Expertos en Eliminar Reportes de Datacrédito y Solución de Deudas en Colombia",
  description = "Sin Huellas Colombia: asesoría jurídica experta para eliminar reportes negativos en Datacrédito y TransUnion, detener embargos y negociar deudas con hasta 70% de descuento. ¡Recupera tu tranquilidad y vida crediticia hoy!",
  canonical = "https://www.sinhuellas.co/",
  image = "https://www.sinhuellas.co/og-image.jpg",
  type = "website",
} = Astro.props;

// Schema.org Structured Data

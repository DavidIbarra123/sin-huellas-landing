---

<!-- Meta Básicos -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="author" content="Sin Huellas Colombia" />
<meta name="publisher" content="Sin Huellas" />
<meta name="keywords" content="sin huellas, sin huellas colombia, sinhuellas, salir de datacredito, eliminar reportes datacredito, abogados datacredito, borrar reportes centrales de riesgo, ley de borron y cuenta nueva, prescripcion deudas colombia, desembargar salario colombia, transunion colombia, historial crediticio limpio, asesoría legal financiera" />

<!-- Geo-localización para posicionamiento en Colombia -->
<meta name="geo.region" content="CO-DC" />
<meta name="geo.placename" content="Bogotá" />
<meta name="geo.position" content="4.7110;-74.0721" />
<meta name="ICBM" content="4.7110, -74.0721" />
<meta name="language" content="Spanish" />

<!-- Open Graph / Redes Sociales -->
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Sin Huellas" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:locale" content="es_CO" />

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@sinhuellasco" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

<!-- Favicons & Mobile theme (Icono oficial de Sin Huellas con transparencia) -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
<link rel="apple-touch-icon" href="/favicon.png" />
<meta name="theme-color" content="#163f30" />
<meta name="apple-mobile-web-app-status-bar-style" content="#163f30" />
<meta name="apple-mobile-web-app-capable" content="yes" />

<!-- Standard AI and LLMs Reference -->
<link rel="alternate" type="text/plain" href="/llms.txt" title="Contexto para Modelos de Inteligencia Artificial" />

<!-- JSON-LD Datos Estructurados para Google, Bing y Motores IA -->
<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

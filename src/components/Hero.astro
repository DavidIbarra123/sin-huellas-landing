---
---

<section class="relative pt-8 pb-16 md:pt-14 md:pb-24 overflow-hidden assist-stage border-b border-[#E7EAE8]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Copywriting with Assistantly Clean Precision & Zoom Entrance -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">

        <!-- Headline with Zoom-In Entrance -->
        <h1 class="hero-zoom-title text-4xl sm:text-5xl lg:text-[3.8rem] font-bold text-[#10201C] tracking-tight leading-[1.08] mb-6">
          Recupera tu <br class="hidden sm:inline" />
          <span class="text-[#183A33] underline decoration-[#C6E79E] decoration-4 underline-offset-4">
            libertad financiera
          </span>
          <br />
          con abogados expertos
        </h1>

        <!-- Subheading with Zoom Entrance -->
        <p class="hero-zoom-desc text-base sm:text-lg text-[#333333] max-w-2xl font-normal leading-relaxed mb-8">
          Ayuda legal especializada para <strong>eliminar reportes negativos en Datacrédito y TransUnion</strong>, negociar deudas con hasta un <strong>70% de descuento</strong> y detener embargos judiciales bajo el rigor de la Ley de Habeas Data en Colombia.
        </p>

        <!-- CTA Buttons with Zoom Entrance & Interactive Zoom on Selection/Hover -->
        <div class="hero-zoom-cta flex flex-col sm:flex-row items-stretch sm:items-center gap-3 w-full sm:w-auto mb-10">
          <a
            href="#simulador"
            class="group inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-full text-sm font-bold bg-[#C6E79E] text-[#0E2A25] hover:bg-[#B2D988] hover:scale-105 hover:shadow-md transition-all duration-300 active:scale-95"
          >
            <span>Evaluar Mi Caso Gratis</span>
            <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>

          <a
            href="#confianza"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-full text-sm font-semibold text-[#183A33] bg-white border border-[#E7EAE8] hover:border-[#183A33]/50 hover:bg-[#F9F9F9] hover:scale-105 hover:shadow-sm transition-all duration-300 active:scale-95"
          >
            <span>¿Por Qué Confiar en Nosotros?</span>
          </a>
        </div>

        <!-- Trust Badges with Zoom Entrance & Hover Scale -->
        <div class="hero-zoom-badges grid grid-cols-2 gap-4 sm:gap-6 pt-6 border-t border-[#E7EAE8] w-full text-xs max-w-md">
          <div class="group flex items-center gap-2.5 p-1 rounded-xl hover:bg-[#F1F7E8]/60 hover:scale-105 transition-all duration-200 cursor-default">
            <span class="w-5 h-5 rounded-full bg-[#E6F3D4] text-[#183A33] group-hover:bg-[#C6E79E] group-hover:scale-115 flex items-center justify-center font-bold text-[11px] flex-shrink-0 transition-all duration-200">
              ✓
            </span>
            <div class="flex flex-col">
              <span class="font-bold text-[#10201C] group-hover:text-[#183A33] transition-colors">100% Confidencial</span>
              <span class="text-[#333333]/70 text-[11px]">Secreto profesional</span>
            </div>
          </div>

          <div class="group flex items-center gap-2.5 p-1 rounded-xl hover:bg-[#F1F7E8]/60 hover:scale-105 transition-all duration-200 cursor-default">
            <span class="w-5 h-5 rounded-full bg-[#E6F3D4] text-[#183A33] group-hover:bg-[#C6E79E] group-hover:scale-115 flex items-center justify-center font-bold text-[11px] flex-shrink-0 transition-all duration-200">
              ✓
            </span>
            <div class="flex flex-col">
              <span class="font-bold text-[#10201C] group-hover:text-[#183A33] transition-colors">Vía 100% Legal</span>
              <span class="text-[#333333]/70 text-[11px]">Leyes 1266 y 2157</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Assistantly-Style Clean Flat Card (No heavy shadows, subtle borders) -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Floating Assistantly-Style Sticker Badge (Top Right) -->
          <div class="hidden sm:flex absolute -top-4 -right-4 z-20 items-center gap-2 px-3.5 py-1.5 rounded-full bg-white border border-[#E7EAE8] shadow-md assist-float-a">
            <span class="w-2 h-2 rounded-full bg-[#183A33]"></span>
            <span class="num-assist text-xs font-bold text-[#183A33]">+405 pts Recuperados ↗</span>
          </div>

          <!-- Top Floating Status Pill -->
          <div class="mb-3 flex items-center justify-between px-4 py-2 rounded-2xl bg-white border border-[#E7EAE8] shadow-sm animate-float-slow">
            <div class="flex items-center gap-2.5">
              <img src="/logo-sin-huellas.png" alt="Logo Sin Huellas" class="h-7 w-auto object-contain" />
              <div class="h-4 w-px bg-[#E7EAE8]"></div>
              <span class="text-xs font-bold text-[#183A33]">
                Firma Jurídica Acreditada
              </span>
            </div>
            <span class="num-assist text-[10px] font-bold bg-[#E6F3D4] text-[#183A33] px-2.5 py-0.5 rounded-full">
              Habeas Data
            </span>
          </div>

          <!-- Main Clean Flat Card (Assistantly Style with Motion) -->
          <div id="hero-dossier" class="relative bg-white rounded-2xl p-6 sm:p-7 border border-[#E7EAE8] shadow-sm hover-lift-assist transition-all duration-300">
            
            <!-- Card Header -->
            <div class="flex items-center justify-between pb-4 border-b border-[#E7EAE8]">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-[#F1F7E8] text-[#183A33] flex items-center justify-center">
                  <svg class="w-4 h-4 text-[#183A33]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                  </svg>
                </div>
                <div>
                  <h3 class="font-bold text-xs sm:text-sm text-[#10201C]">
                    Expediente Procesal Digital
                  </h3>
                  <p class="text-[11px] text-[#333333]/70 font-medium">
                    Restitución Crediticia Certificada
                  </p>
                </div>
              </div>
              <span class="inline-flex items-center gap-1.5 text-[10px] font-bold bg-[#E6F3D4] text-[#183A33] px-2.5 py-1 rounded-full border border-[#C6E79E]/60">
                <span class="w-1.5 h-1.5 rounded-full bg-[#183A33]"></span>
                <span>Caso Activo</span>
              </span>
            </div>

            <!-- Score Transformation Visual -->
            <div class="py-5 space-y-3.5">
              
              <!-- Before state -->
              <div class="p-3.5 rounded-xl bg-[#F9F9F9] border border-[#E7EAE8] flex items-center justify-between">
                <div class="flex items-center gap-2.5">
                  <div class="w-7 h-7 rounded-lg bg-red-100 text-red-700 flex items-center justify-center font-bold text-xs">
                    ✕
                  </div>
                  <div>
                    <span class="block text-xs font-semibold text-[#10201C]">Estado Inicial</span>
                    <span class="text-[11px] text-[#333333]/70">3 Reportes en mora (&gt; 5 años)</span>
                  </div>
                </div>
                <div class="text-right">
                  <span class="num-assist text-sm font-bold text-red-600 block">380 pts</span>
                  <span class="text-[9px] uppercase font-bold text-red-500 tracking-wider">Bloqueado</span>
                </div>
              </div>

              <!-- Animated Clean Flow Indicator in Lime -->
              <div class="flex items-center justify-center relative py-1">
                <div class="shimmer-badge px-4 py-1.5 rounded-full bg-[#E6F3D4] text-[#183A33] text-[11px] font-bold flex items-center gap-2 border border-[#C6E79E]/60 shadow-sm">
                  <svg class="w-3.5 h-3.5 text-[#183A33] animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
                  </svg>
                  <span>Intervención Legal de Habeas Data</span>
                </div>
              </div>

              <!-- After state with Dynamic Score -->
              <div class="p-3.5 rounded-xl bg-[#F1F7E8] border border-[#C6E79E]/60">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 rounded-lg bg-[#C6E79E] text-[#0E2A25] flex items-center justify-center font-bold text-xs">
                      ✓
                    </div>
                    <div>
                      <span class="block text-xs font-bold text-[#183A33]">Historial Restituido</span>
                      <span class="text-[11px] text-[#183A33]/80">Datacrédito & TransUnion al día</span>
                    </div>
                  </div>
                  <div class="text-right">
                    <span id="hero-score-counter" class="num-assist text-sm sm:text-base font-extrabold text-[#183A33] block transition-colors duration-300">785 pts</span>
                    <span class="text-[9px] uppercase font-bold text-[#183A33] tracking-wider">Apto Crédito</span>
                  </div>
                </div>

                <!-- Animated Progress Track -->
                <div class="mt-2.5 h-1.5 w-full bg-[#E7EAE8] rounded-full overflow-hidden">
                  <div id="hero-score-bar" class="h-full bg-gradient-to-r from-[#AEDA7E] to-[#183A33] rounded-full transition-all duration-1000 ease-out" style="width: 88%;"></div>
                </div>
              </div>

            </div>

            <!-- Bottom Achievement Box -->
            <div class="pt-3.5 border-t border-[#E7EAE8] flex items-center justify-between text-xs">
              <div class="flex items-center gap-1.5 text-[#333333]">
                <span class="text-[#183A33] font-bold">✓</span>
                <span class="font-medium">Paz y Salvo Legal Obtenido</span>
              </div>
              <span class="num-assist font-bold text-[#183A33]">21 Días Hábiles</span>
            </div>

          </div>

          <!-- Bottom Metric Chip (Modern Clean Numerals) -->
          <div class="mt-3 flex items-center justify-between px-4 py-2.5 rounded-2xl bg-[#0E2A25] text-white">
            <div class="flex items-center gap-2">
              <span class="text-xs text-[#C6E79E]">★</span>
              <span class="num-assist text-xs font-bold">Calificación 4.9 / 5.0</span>
            </div>
            <span class="num-assist text-xs text-[#C6E79E] font-bold">+12.800 Casos en Colombia</span>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  // Dynamic Score Rolling Animation on Load
  const scoreCounter = document.getElementById('hero-score-counter');
  const scoreBar = document.getElementById('hero-score-bar');
  if (scoreCounter) {
    const target = 785;
    const start = 380;
    const duration = 1600;
    let startTime: number | null = null;

    const animateScore = (timestamp: number) => {
      if (!startTime) startTime = timestamp;
      const progress = Math.min((timestamp - startTime) / duration, 1);
      // Ease out cubic
      const ease = 1 - Math.pow(1 - progress, 3);
      const current = Math.floor(start + (target - start) * ease);
      scoreCounter.textContent = `${current} pts`;

      if (scoreBar) {
        scoreBar.style.width = `${40 + 48 * ease}%`;
      }

      if (progress < 1) {
        requestAnimationFrame(animateScore);
      } else {
        scoreCounter.textContent = `${target} pts`;
      }
    };

    // Run animation smoothly
    setTimeout(() => {
      requestAnimationFrame(animateScore);
    }, 400);
  }

  // Subtle interactive hover tilt
  const card = document.getElementById('hero-dossier');
  if (card) {
    card.addEventListener('mousemove', (e) => {
      const rect = card.getBoundingClientRect();
      const x = e.clientX - rect.left - rect.width / 2;
      const y = e.clientY - rect.top - rect.height / 2;
      card.style.transform = `perspective(1000px) rotateX(${(-y / rect.height) * 5}deg) rotateY(${(x / rect.width) * 5}deg) translateY(-4px)`;
    });
    card.addEventListener('mouseleave', () => {
      card.style.transform = 'perspective(1000px) rotateX(0deg) rotateY(0deg) translateY(0px)';
    });
  }
</script>

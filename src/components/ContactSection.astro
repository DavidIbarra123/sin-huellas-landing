---
---

<section id="agendar" class="py-20 md:py-28 bg-gradient-to-b from-[#f0f6f3] to-[#fbfcfa] relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left info Column -->
      <div class="lg:col-span-5 flex flex-col justify-between reveal-on-scroll">
        <div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-[#10201C] tracking-tight mb-4 leading-tight">
            Estamos listos para <br />
            <span class="text-[#183A33] underline decoration-[#C6E79E] decoration-4 underline-offset-4">
              defender tus derechos
            </span>
          </h2>
          <p class="text-base text-[#333333]/80 mb-8 leading-relaxed font-normal">
            Agenda tu diagnóstico jurídico o déjanos un mensaje. Un abogado de Sin Huellas analizará tu caso y te responderá en minutos.
          </p>

          <!-- Contact items list -->
          <div class="space-y-6">
            
            <!-- WhatsApp / Tel -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-2xl bg-[#E6F3D4] text-[#183A33] flex items-center justify-center flex-shrink-0 shadow-sm border border-[#C6E79E]/40">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div>
                <span class="text-xs uppercase font-bold text-[#333333]/60 block">WhatsApp y Llamadas</span>
                <a href="https://wa.me/573005734474" target="_blank" rel="noopener noreferrer" class="text-base sm:text-lg font-bold text-[#10201C] hover:text-[#183A33] transition-colors">
                  +57 300 573 4474
                </a>
                <span class="block text-xs text-[#183A33] font-semibold">Respuesta promedio: &lt; 10 min</span>
              </div>
            </div>

            <!-- Email -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-2xl bg-[#E6F3D4] text-[#183A33] flex items-center justify-center flex-shrink-0 shadow-sm border border-[#C6E79E]/40">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div>
                <span class="text-xs uppercase font-bold text-[#333333]/60 block">Correo Electrónico</span>
                <a href="mailto:gerencia@sinhuellas.co" class="text-base sm:text-lg font-bold text-[#10201C] hover:text-[#183A33] transition-colors">
                  gerencia@sinhuellas.co
                </a>
                <span class="block text-xs text-[#333333]/70">Atención jurídica institucional</span>
              </div>
            </div>

            <!-- Location -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-2xl bg-[#E6F3D4] text-[#183A33] flex items-center justify-center flex-shrink-0 shadow-sm border border-[#C6E79E]/40">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <span class="text-xs uppercase font-bold text-[#333333]/60 block">Sede y Cobertura</span>
                <p class="text-sm font-bold text-[#10201C]">Bogotá, Colombia</p>
                <span class="block text-xs text-[#333333]/70">Atención digital a personas en todo el país</span>
              </div>
            </div>

            <!-- Hours -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-2xl bg-[#E6F3D4] text-[#183A33] flex items-center justify-center flex-shrink-0 shadow-sm border border-[#C6E79E]/40">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <span class="text-xs uppercase font-bold text-[#333333]/60 block">Horario de Operación</span>
                <p class="text-sm font-bold text-[#10201C]">Lun - Vie: 8:00 AM – 6:00 PM</p>
                <span class="block text-xs text-[#333333]/70">Sábados: 9:00 AM – 1:00 PM</span>
              </div>
            </div>

          </div>
        </div>
      </div>

      <!-- Right Form Column Assistantly style with Cinematic Card Zoom -->
      <div class="lg:col-span-7 reveal-on-scroll">
        <div class="rounded-3xl p-8 sm:p-10 bg-white shadow-sm border border-[#E7EAE8] hover:border-[#183A33]/40 hover:scale-[1.02] hover:-translate-y-1 hover:shadow-xl transition-all duration-300 ease-out">
          
          <div class="mb-6">
            <h3 class="text-2xl font-bold text-[#10201C]">Envíanos un mensaje</h3>
            <p class="text-xs text-[#333333]/70">Tus datos están protegidos por el secreto profesional y Ley de Habeas Data.</p>
          </div>

          <form id="contact-form" class="space-y-4">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="name" class="block text-xs font-bold uppercase text-[#10201C] mb-1.5">Nombre Completo *</label>
                <input
                  type="text"
                  id="name"
                  required
                  placeholder="Ej. Juan Pérez"
                  class="w-full px-4 py-3 rounded-xl border border-[#E7EAE8] focus:border-[#183A33] focus:ring-2 focus:ring-[#C6E79E]/40 outline-none text-sm bg-[#F9F9F9] text-[#10201C]"
                />
              </div>

              <div>
                <label for="phone" class="block text-xs font-bold uppercase text-[#10201C] mb-1.5">WhatsApp / Teléfono *</label>
                <input
                  type="tel"
                  id="phone"
                  required
                  placeholder="Ej. 300 123 4567"
                  class="w-full px-4 py-3 rounded-xl border border-[#E7EAE8] focus:border-[#183A33] focus:ring-2 focus:ring-[#C6E79E]/40 outline-none text-sm bg-[#F9F9F9] text-[#10201C]"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="email" class="block text-xs font-bold uppercase text-[#10201C] mb-1.5">Correo Electrónico</label>
                <input
                  type="email"
                  id="email"
                  placeholder="tucorreo@ejemplo.com"
                  class="w-full px-4 py-3 rounded-xl border border-[#E7EAE8] focus:border-[#183A33] focus:ring-2 focus:ring-[#C6E79E]/40 outline-none text-sm bg-[#F9F9F9] text-[#10201C]"
                />
              </div>

              <div>
                <label for="service-select" class="block text-xs font-bold uppercase text-[#10201C] mb-1.5">Servicio de Interés *</label>
                <select
                  id="service-select"
                  required
                  class="w-full px-4 py-3 rounded-xl border border-[#E7EAE8] focus:border-[#183A33] focus:ring-2 focus:ring-[#C6E79E]/40 outline-none text-sm bg-[#F9F9F9] text-[#10201C]"
                >
                  <option value="Eliminación de Reporte en Datacrédito">Eliminar Reporte en Datacrédito / TransUnion</option>
                  <option value="Consultoría Completa $150.000">Consultoría Completa + Diagnóstico Jurídico ($150.000)</option>
                  <option value="Llamada de Asesor Gratis">Llamada de Asesor Gratis (15 min)</option>
                  <option value="Desembargo de Salario o Cuentas">Detener o Levantar Embargo Judicial</option>
                  <option value="Negociación de Deudas">Negociación de Deudas con Descuento</option>
                </select>
              </div>
            </div>

            <div>
              <label for="message" class="block text-xs font-bold uppercase text-[#10201C] mb-1.5">Cuéntanos brevemente tu caso</label>
              <textarea
                id="message"
                rows="3"
                placeholder="Ej. Tengo un reporte en Datacrédito por una deuda de hace 6 años y quiero saber si aplica caducidad..."
                class="w-full px-4 py-3 rounded-xl border border-[#E7EAE8] focus:border-[#183A33] focus:ring-2 focus:ring-[#C6E79E]/40 outline-none text-sm bg-[#F9F9F9] text-[#10201C]"
              ></textarea>
            </div>

            <button
              type="submit"
              class="group w-full py-4 rounded-full bg-[#183A33] hover:bg-[#C6E79E] text-[#C6E79E] hover:text-[#183A33] border-2 border-[#183A33] hover:border-[#C6E79E] font-bold text-sm sm:text-base shadow-md hover:shadow-xl hover:scale-[1.02] active:scale-95 transition-all duration-300 flex items-center justify-center gap-3 cursor-pointer"
            >
              <span class="tracking-wide">Enviar Solicitud a un Abogado</span>
              <svg class="w-5 h-5 fill-none stroke-current transition-transform duration-300 group-hover:translate-x-1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </button>

            <div id="form-feedback" class="hidden p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs text-center font-bold">
              ¡Mensaje preparado! Te redirigiremos a WhatsApp con tu caso redactado para atención prioritaria inmediata.
            </div>

          </form>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const feedback = document.getElementById('form-feedback');

  if (form && feedback) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('name') as HTMLInputElement)?.value;
      const phone = (document.getElementById('phone') as HTMLInputElement)?.value;
      const service = (document.getElementById('service-select') as HTMLSelectElement)?.value;
      const message = (document.getElementById('message') as HTMLTextAreaElement)?.value;

      feedback.classList.remove('hidden');

      const text = `Hola Sin Huellas, mi nombre es ${name}.\nTel: ${phone}\nInterés: ${service}\nDetalle: ${message || 'Deseo asesoría para mi caso'}`;
      const url = `https://wa.me/573005734474?text=${encodeURIComponent(text)}`;

      setTimeout(() => {
        window.open(url, '_blank');
      }, 800);
    });
  }
</script>

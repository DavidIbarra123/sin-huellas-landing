---
const trustCards = [
  {
    roman: "I",
    number: "01",
    tag: "Constitucionalidad & Debido Proceso",
    title: "Amparo Constitucional y Cumplimiento Estricto de la Ley",
    desc: "Cero atajos, cero fraudes. Desestimamos tajantemente los 'borrados express en 24 horas' que constituyen delitos penales. Actuamos con la máxima investidura jurídica amparados bajo el Artículo 15 de la Constitución Política y las Leyes 1266 de 2008 y 2157 de 2021 de Borrón y Cuenta Nueva, radicando derechos de petición fundamentados y acciones de tutela formales ante juzgados de la República.",
    theme: "white",
    tags: ["Art. 15 Constitución", "Ley 2157 Borrón y Cuenta Nueva", "Acciones de Tutela", "Corte Constitucional C-282/21"],
    highlight: "Garantía de Legalidad",
  },
  {
    roman: "II",
    number: "02",
    tag: "Auditoría Forense 360°",
    title: "Peritaje Exhaustivo en Rama Judicial y 5 Centrales",
    desc: "Nuestra labor parte de un dictamen técnico integral. Auditamos Datacrédito Experian, TransUnion CIFIN, el Sistema de Consulta de Procesos de la Rama Judicial (demandas civiles y medidas cautelares), el Registro de Garantías Mobiliarias y SIMIT para estructurar una estrategia judicial inapelable.",
    theme: "dark",
    tags: ["Rama Judicial Colombia", "Datacrédito Experian", "TransUnion CIFIN", "Juzgados Civiles de Circuito"],
    highlight: "Dictamen Técnico Multifuente",
  },
  {
    roman: "III",
    number: "03",
    tag: "Defensa Procesal & Desembargos",
    title: "Oposición en Juicios Ejecutivos y Desembargos",
    desc: "Intervenimos ante despachos judiciales para frenar cobros coactivos y revocar medidas cautelares indebidas sobre cuentas de ahorro inembargables y salarios mínimos legales, protegiendo el mínimo vital garantizado por la Carta Política.",
    theme: "white",
    tags: ["Desembargo de Salarios", "Código General del Proceso", "Cuentas Inembargables", "Mínimo Vital"],
    highlight: "Levantamiento de Medidas",
  },
  {
    roman: "IV",
    number: "04",
    tag: "Negociación & Protocolización",
    title: "Negociación con Quitas de hasta el 70% y Paz y Salvo",
    desc: "Litigamos frente a los apoderados de bancos, cooperativas y firmas de cobranza. Exigimos la caducidad obligatoria a los 8 años de mora y cerramos acuerdos de pago justos con quitas de hasta el 70%, protocolizando tu paz y salvo y la supresión definitiva del dato negativo.",
    theme: "dark",
    tags: ["Quitas del 40% al 70%", "Prescripción Cambiaria", "Paz y Salvo Notarial", "Caducidad a los 8 Años"],
    highlight: "Paz y Salvo Definitivo",
  },
];
---

<section id="confianza" class="py-20 md:py-32 relative bg-[#F9F9F9] border-b border-[#E7EAE8] overflow-visible">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      
      <!-- Left Column: Sticky Section (Assistantly Clean Layout) -->
      <div class="lg:col-span-5 lg:sticky lg:top-24 space-y-6">
        
        <!-- Section Title & Message with Smooth Scroll Zoom cuando baja -->
        <div class="reveal-on-scroll trust-header-zoom group cursor-default">
          <h2 class="text-3xl sm:text-4xl lg:text-[2.8rem] font-bold text-[#10201C] tracking-tight leading-[1.12] mb-4 transition-transform duration-500 ease-out group-hover:scale-105 origin-left">
            ¿Por qué confiar <br />
            <span class="text-[#183A33] underline decoration-[#C6E79E] decoration-4 underline-offset-4">
              tu caso legal
            </span>
            <br />
            en Sin Huellas?
          </h2>

          <p class="text-base text-[#333333] leading-relaxed font-normal transition-transform duration-500 ease-out group-hover:scale-102 origin-left">
            Recuperar tu historial crediticio es una decisión fundamental para tu patrimonio. Por eso aplicamos la fuerza de la ley con técnica procesal, transparencia y vocación de servicio.
          </p>
        </div>

        <!-- Official Logo Card with Assistantly Style Laser Beam -->
        <div class="rounded-2xl p-5 bg-white border border-[#E7EAE8] shadow-sm space-y-3">
          
          <div class="flex items-center justify-between text-xs pb-3 border-b border-[#E7EAE8]">
            <span class="font-bold text-[#183A33] flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-[#183A33]"></span>
              Identidad Oficial Registrada
            </span>
            <span class="text-[10px] num-assist font-bold bg-[#E6F3D4] text-[#183A33] px-2.5 py-0.5 rounded-full">
              Habeas Data
            </span>
          </div>

          <!-- Official Logo with Laser Scanning Effect -->
          <div class="relative flex items-center justify-center py-5 px-3 bg-[#F9F9F9] rounded-xl border border-[#E7EAE8] overflow-hidden">
            
            <!-- Laser Scanning Beam in Lime -->
            <div class="laser-scanner pointer-events-none"></div>

            <img
              src="/logo-sin-huellas.png"
              alt="Sin Huellas - Nuevas Oportunidades"
              class="max-h-20 sm:max-h-24 w-auto object-contain relative z-10"
            />
          </div>

          <div class="pt-1 flex items-center justify-between text-xs">
            <span class="font-medium text-[#333333]">Garantía Procesal</span>
            <span class="text-[11px] font-semibold text-[#183A33]">Leyes 1266 & 2157</span>
          </div>
        </div>

        <!-- Trust Stats (Clean Minimalist List) -->
        <div class="pt-2 space-y-2.5 text-xs text-[#183A33] font-medium">
          <div class="flex items-center gap-2.5">
            <span class="w-5 h-5 rounded-full bg-[#E6F3D4] text-[#183A33] flex items-center justify-center font-bold text-[10px] flex-shrink-0">
              ✓
            </span>
            <span>Más de 12.800 procesos evaluados favorablemente.</span>
          </div>

          <div class="flex items-center gap-2.5">
            <span class="w-5 h-5 rounded-full bg-[#E6F3D4] text-[#183A33] flex items-center justify-center font-bold text-[10px] flex-shrink-0">
              ✓
            </span>
            <span>Abogados titulados especialistas en derecho del consumidor financiero.</span>
          </div>

          <div class="flex items-center gap-2.5">
            <span class="w-5 h-5 rounded-full bg-[#E6F3D4] text-[#183A33] flex items-center justify-center font-bold text-[10px] flex-shrink-0">
              ✓
            </span>
            <span>Pasarela institucional PSE bajo estándares bancarios.</span>
          </div>
        </div>

        <!-- Assistantly Style Lime Button -->
        <div class="pt-2">
          <a
            href="https://wa.me/573005734474?text=Hola%20Sin%20Huellas,%20solicito%20asesor%C3%ADa%20jur%C3%ADdica%20con%20un%20abogado"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-7 py-3.5 rounded-full text-xs font-bold bg-[#C6E79E] text-[#0E2A25] hover:bg-[#B2D988] transition-all duration-200 active:scale-95 shadow-sm"
          >
            <span>Consultar con un Abogado</span>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>

      </div>

      <!-- Right Column: Stacking Folio Cards (Clean 1px Borders, Minimal Shadows) -->
      <div class="lg:col-span-7 space-y-8 pb-24">
        {trustCards.map((card, idx) => (
          <div
            class={`trust-card sticky rounded-3xl p-7 sm:p-9 transition-all duration-300 ${
              card.theme === 'dark'
                ? 'bg-[#103028] text-white border border-[#1b4339] shadow-xl'
                : 'bg-white text-[#183A33] border border-[#E7EAE8] shadow-lg hover:border-[#C6E79E]'
            }`}
            style={`top: calc(5.5rem + ${idx * 28}px); z-index: ${idx + 10};`}
          >
            
            <!-- Card Header: Number & Tag -->
            <div class={`flex items-center justify-between mb-6 pb-4 border-b ${
              card.theme === 'dark' ? 'border-white/10' : 'border-[#E7EAE8]'
            }`}>
              <div class="flex items-center gap-3.5">
                <span class={`w-10 h-10 rounded-2xl flex items-center justify-center num-assist font-extrabold text-sm ${
                  card.theme === 'dark'
                    ? 'bg-[#C6E79E] text-[#0E2A25]'
                    : 'bg-[#E6F3D4] text-[#183A33]'
                }`}>
                  {card.number}
                </span>
                <div>
                  <span class={`text-xs font-bold uppercase tracking-wider block ${
                    card.theme === 'dark' ? 'text-[#C6E79E]' : 'text-[#10201C]'
                  }`}>
                    {card.tag}
                  </span>
                  <span class={`text-xs block font-medium ${
                    card.theme === 'dark' ? 'text-white/70' : 'text-[#333333]/70'
                  }`}>
                    {card.highlight}
                  </span>
                </div>
              </div>

              <!-- Mini Official Logo Stamp -->
              <div class="px-3 py-1 rounded-full bg-white border border-[#E7EAE8] flex items-center gap-2 shadow-xs">
                <img
                  src="/logo-sin-huellas.png"
                  alt="Sin Huellas"
                  class="h-4 w-auto object-contain"
                />
                <span class="text-[10px] num-assist font-bold text-[#183A33]">Oficial</span>
              </div>
            </div>

            <!-- Card Title -->
            <h3 class={`text-2xl sm:text-3xl font-extrabold tracking-tight mb-4 ${
              card.theme === 'dark' ? 'text-white' : 'text-[#10201C]'
            }`}>
              {card.title}
            </h3>

            <!-- Card Body -->
            <p class={`text-sm sm:text-base leading-relaxed mb-6 font-normal ${
              card.theme === 'dark' ? 'text-white/80' : 'text-[#333333]'
            }`}>
              {card.desc}
            </p>

            <!-- Tags List in Assistantly Chips Style -->
            <div class="flex flex-wrap gap-2.5 pt-1">
              {card.tags.map(tag => (
                <span class={`text-xs num-assist font-medium px-3.5 py-1.5 rounded-full ${
                  card.theme === 'dark'
                    ? 'bg-white/10 text-white/90 border border-white/15'
                    : 'bg-[#E6F3D4] text-[#183A33] border border-[#C6E79E]/40'
                }`}>
                  {tag}
                </span>
              ))}
            </div>

          </div>
        ))}
      </div>

    </div>

  </div>
</section>

<style>
  /* Zoom cinematográfico cuando el usuario baja a esta sección */
  .trust-header-zoom {
    opacity: 0;
    transform: translateY(36px) scale(0.84);
    filter: blur(8px);
    transition: opacity 1.1s cubic-bezier(0.16, 1, 0.3, 1),
                transform 1.1s cubic-bezier(0.16, 1, 0.3, 1),
                filter 0.9s cubic-bezier(0.16, 1, 0.3, 1);
    will-change: transform, opacity, filter;
  }

  .trust-header-zoom.is-revealed {
    opacity: 1;
    transform: translateY(0) scale(1);
    filter: blur(0px);
  }

  /* Sticky Stacking Animation */
  .trust-card {
    will-change: transform;
  }

  /* Laser scanner beam in Lime */
  .laser-scanner {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, #C6E79E, #ffffff, #C6E79E, transparent);
    box-shadow: 0 0 10px 2px rgba(198, 231, 158, 0.7);
    animation: scanAnimation 3.5s ease-in-out infinite alternate;
    z-index: 20;
  }

  @keyframes scanAnimation {
    0% {
      top: 5%;
      opacity: 0.4;
    }
    50% {
      opacity: 1;
    }
    100% {
      top: 92%;
      opacity: 0.4;
    }
  }
</style>

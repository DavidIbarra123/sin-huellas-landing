---
---

<div id="live-toast" class="fixed bottom-6 left-6 z-40 max-w-sm hidden sm:flex items-center gap-3.5 px-4 py-3 rounded-2xl bg-white/95 backdrop-blur-xl border border-emerald-900/10 shadow-[0_15px_35px_-5px_rgba(22,63,48,0.2)] transition-all duration-500 transform translate-y-2 opacity-0 pointer-events-auto">
  
  <!-- Mini Icon -->
  <div class="relative flex-shrink-0">
    <div class="w-9 h-9 rounded-xl bg-brand-emerald text-brand-gold flex items-center justify-center font-bold text-xs shadow-md border border-brand-gold/30">
      ✓
    </div>
  </div>

  <!-- Message Body -->
  <div class="flex-grow pr-2">
    <div class="flex items-center justify-between gap-2">
      <span class="text-[10px] font-black uppercase tracking-wider text-brand-gold-dark flex items-center gap-1">
        <span>Caso Resuelto</span>
        <span>•</span>
        <span id="toast-city">Bogotá</span>
      </span>
      <span id="toast-time" class="text-[10px] text-emerald-900/50">Hace 3 min</span>
    </div>
    <p id="toast-text" class="text-xs font-bold text-brand-emerald-deep leading-snug mt-0.5 line-clamp-2">
      Reporte de 6 años eliminado en Datacrédito con paz y salvo.
    </p>
  </div>

  <!-- Dismiss Button -->
  <button
    id="toast-close"
    type="button"
    class="text-emerald-900/40 hover:text-emerald-900 transition-colors p-1"
    aria-label="Cerrar notificación"
  >
    ✕
  </button>
</div>

<script>
  const activities = [
    { city: "Bogotá, D.C.", time: "Hace 4 min", text: "Carlos M. logró eliminar 3 reportes negativos de 5 años en Datacrédito." },
    { city: "Medellín", time: "Hace 11 min", text: "Deuda de $16M negociada con 68% de descuento y paz y salvo firmado." },
    { city: "Cali", time: "Hace 23 min", text: "Embargo sobre salario levantado ante el juzgado civil." },
    { city: "Barranquilla", time: "Hace 35 min", text: "Revisión técnica de 5 centrales completada con diagnóstico por escrito." },
    { city: "Bucaramanga", time: "Hace 48 min", text: "Caducidad de reporte de 8 años aplicada bajo Ley 1266." }
  ];

  const toast = document.getElementById('live-toast');
  const cityEl = document.getElementById('toast-city');
  const timeEl = document.getElementById('toast-time');
  const textEl = document.getElementById('toast-text');
  const closeBtn = document.getElementById('toast-close');

  let currentIndex = 0;
  let isClosed = false;

  if (toast && cityEl && timeEl && textEl && closeBtn) {
    closeBtn.addEventListener('click', () => {
      isClosed = true;
      toast.classList.add('opacity-0', 'translate-y-4');
      setTimeout(() => toast.remove(), 400);
    });

    function showNext() {
      if (isClosed) return;

      const current = activities[currentIndex];
      cityEl.textContent = current.city;
      timeEl.textContent = current.time;
      textEl.textContent = current.text;

      // Slide in
      toast.classList.remove('opacity-0', 'translate-y-2');
      toast.classList.add('opacity-100', 'translate-y-0');

      // Hold for 5.5s then slide out
      setTimeout(() => {
        if (isClosed) return;
        toast.classList.remove('opacity-100', 'translate-y-0');
        toast.classList.add('opacity-0', 'translate-y-2');
        
        currentIndex = (currentIndex + 1) % activities.length;
        setTimeout(showNext, 3500);
      }, 5500);
    }

    // Initial trigger after 2 seconds
    setTimeout(showNext, 2000);
  }
</script>
